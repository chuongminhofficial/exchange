{
  "info": {
    "_postman_id": "exchange-saas-api-v4-2026",
    "name": "Exchange Rate SaaS API (Official Public Client Collection - EN)",
    "description": "Official Postman Collection v2.1.0 for integrating the Exchange SaaS & SUE Real-Time API: 150+ ISO-4217 Fiat Currencies, 310+ Cryptocurrencies, Forex Pairs, Commodities (Spot Gold XAUUSD, Silver, Crude Oil), and Global Stock Indices.\n\n- **Base Gateway URL**: `https://api.l.lc/exchange`\n- **Authentication**: Pass Header `X-API-Key: {{api_key}}` or Query Parameter `?api_key={{api_key}}`\n- **Response Architecture**: In-Memory Pre-rendered `[]byte` JSON (Sub-millisecond latency)\n- **Localization**: Supports `?lang=en` (default) and `?lang=vi` (Vietnamese)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "https://api.l.lc/exchange",
      "type": "string",
      "description": "Base Gateway URL for Exchange SaaS API"
    },
    {
      "key": "api_key",
      "value": "sk_live_your_api_key_here",
      "type": "string",
      "description": "Your Customer SaaS API Key (e.g. sk_live_...)"
    }
  ],
